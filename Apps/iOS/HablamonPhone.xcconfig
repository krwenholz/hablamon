// Build settings for the iPhone app. The Xcode project keeps only what can't live here.
// Signing: Local.xcconfig (gitignored, written by scripts/phone.sh) sets DEVELOPMENT_TEAM, and
// may override PRODUCT_BUNDLE_IDENTIFIER if this one is taken.

PRODUCT_NAME = Hablamon
PRODUCT_BUNDLE_IDENTIFIER = dev.krw.hablamon.phone
MARKETING_VERSION = 0.1
CURRENT_PROJECT_VERSION = 1

SDKROOT = iphoneos
SUPPORTED_PLATFORMS = iphoneos iphonesimulator
IPHONEOS_DEPLOYMENT_TARGET = 18.0
TARGETED_DEVICE_FAMILY = 1,2
SWIFT_VERSION = 6.0
CODE_SIGN_STYLE = Automatic
ENABLE_PREVIEWS = NO

GENERATE_INFOPLIST_FILE = YES
INFOPLIST_KEY_CFBundleDisplayName = Hablamon
INFOPLIST_KEY_NSCameraUsageDescription = Hablamon reads the game's dialogue on the TV through the camera.
INFOPLIST_KEY_UIApplicationSceneManifest_Generation = YES
INFOPLIST_KEY_UILaunchScreen_Generation = YES
INFOPLIST_KEY_UIRequiresFullScreen = YES
INFOPLIST_KEY_UIStatusBarHidden = YES
INFOPLIST_KEY_UISupportedInterfaceOrientations = UIInterfaceOrientationLandscapeLeft UIInterfaceOrientationLandscapeRight
INFOPLIST_KEY_UISupportedInterfaceOrientations_iPad = UIInterfaceOrientationLandscapeLeft UIInterfaceOrientationLandscapeRight
// Show the data folder (logs, transcripts, settings) in the Files app.
INFOPLIST_KEY_UIFileSharingEnabled = YES
INFOPLIST_KEY_LSSupportsOpeningDocumentsInPlace = YES

#include? "Local.xcconfig"
