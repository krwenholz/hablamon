{
  "$schema" : "https://json-schema.org/draft/2020-12/schema",
  "title" : "game-profile",
  "type" : "object",
  "required" : [
    "schemaVersion",
    "id",
    "name",
    "frameSize",
    "regions",
    "detection"
  ],
  "properties" : {
    "$schema" : {
      "type" : [
        "string",
        "null"
      ]
    },
    "schemaVersion" : {
      "type" : "integer"
    },
    "id" : {
      "type" : "string",
      "pattern" : "^[a-z0-9-]+$",
      "description" : "Short identifier, such as `scarlet`."
    },
    "name" : {
      "type" : "string"
    },
    "frameSize" : {
      "type" : "object",
      "required" : [
        "width",
        "height"
      ],
      "properties" : {
        "width" : {
          "type" : "integer",
          "minimum" : 1.0
        },
        "height" : {
          "type" : "integer",
          "minimum" : 1.0
        }
      },
      "additionalProperties" : false,
      "description" : "Size of the perspective-corrected frame the regions are measured in."
    },
    "regions" : {
      "type" : "object",
      "required" : [
        "dialogueBox",
        "bodyText",
        "textLines",
        "nameTag"
      ],
      "properties" : {
        "dialogueBox" : {
          "type" : "object",
          "required" : [
            "x",
            "y",
            "width",
            "height"
          ],
          "properties" : {
            "x" : {
              "type" : "integer",
              "minimum" : 0.0
            },
            "y" : {
              "type" : "integer",
              "minimum" : 0.0
            },
            "width" : {
              "type" : "integer",
              "minimum" : 1.0
            },
            "height" : {
              "type" : "integer",
              "minimum" : 1.0
            }
          },
          "additionalProperties" : false
        },
        "bodyText" : {
          "type" : "object",
          "required" : [
            "x",
            "y",
            "width",
            "height"
          ],
          "properties" : {
            "x" : {
              "type" : "integer",
              "minimum" : 0.0
            },
            "y" : {
              "type" : "integer",
              "minimum" : 0.0
            },
            "width" : {
              "type" : "integer",
              "minimum" : 1.0
            },
            "height" : {
              "type" : "integer",
              "minimum" : 1.0
            }
          },
          "additionalProperties" : false
        },
        "textLines" : {
          "type" : "object",
          "required" : [
            "x",
            "y",
            "width",
            "height"
          ],
          "properties" : {
            "x" : {
              "type" : "integer",
              "minimum" : 0.0
            },
            "y" : {
              "type" : "integer",
              "minimum" : 0.0
            },
            "width" : {
              "type" : "integer",
              "minimum" : 1.0
            },
            "height" : {
              "type" : "integer",
              "minimum" : 1.0
            }
          },
          "additionalProperties" : false,
          "description" : "The rows of `bodyText` that hold the two text lines; the rest of `bodyText` is blank panel."
        },
        "nameTag" : {
          "type" : "object",
          "required" : [
            "x",
            "y",
            "width",
            "height"
          ],
          "properties" : {
            "x" : {
              "type" : "integer",
              "minimum" : 0.0
            },
            "y" : {
              "type" : "integer",
              "minimum" : 0.0
            },
            "width" : {
              "type" : "integer",
              "minimum" : 1.0
            },
            "height" : {
              "type" : "integer",
              "minimum" : 1.0
            }
          },
          "additionalProperties" : false
        },
        "advanceIndicator" : {
          "oneOf" : [
            {
              "type" : "object",
              "required" : [
                "x",
                "y",
                "width",
                "height"
              ],
              "properties" : {
                "x" : {
                  "type" : "integer",
                  "minimum" : 0.0
                },
                "y" : {
                  "type" : "integer",
                  "minimum" : 0.0
                },
                "width" : {
                  "type" : "integer",
                  "minimum" : 1.0
                },
                "height" : {
                  "type" : "integer",
                  "minimum" : 1.0
                }
              },
              "additionalProperties" : false,
              "description" : "The blinking ▼ shown when a page has finished typing."
            },
            {
              "type" : "null"
            }
          ]
        }
      },
      "additionalProperties" : false
    },
    "detection" : {
      "type" : "object",
      "required" : [
        "edgeStep",
        "maxMarginEdgeDensity",
        "minTextEdgeDensity",
        "tagSaturation",
        "minTagFraction"
      ],
      "properties" : {
        "edgeStep" : {
          "type" : "number",
          "minimum" : 0.0,
          "maximum" : 1.0,
          "description" : "Luminance step (0–1) between vertically adjacent pixels that counts as an edge."
        },
        "maxMarginEdgeDensity" : {
          "type" : "number",
          "minimum" : 0.0,
          "maximum" : 1.0,
          "description" : "Maximum edge density in the body-text rows outside `textLines`, where the panel is blank."
        },
        "minTextEdgeDensity" : {
          "type" : "number",
          "minimum" : 0.0,
          "maximum" : 1.0,
          "description" : "Minimum edge density within `textLines`."
        },
        "tagSaturation" : {
          "type" : "number",
          "minimum" : 0.0,
          "maximum" : 1.0,
          "description" : "A name-tag pixel counts as tag color when its saturation is above this and blue is its strongest channel."
        },
        "minTagFraction" : {
          "type" : "number",
          "minimum" : 0.0,
          "maximum" : 1.0,
          "description" : "Fraction of the name-tag region that must be tag color for the line to have a speaker."
        }
      },
      "additionalProperties" : false
    }
  },
  "additionalProperties" : false
}
