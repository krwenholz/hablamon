{
  "$schema" : "https://json-schema.org/draft/2020-12/schema",
  "title" : "settings",
  "type" : "object",
  "required" : [
    "schemaVersion",
    "engine",
    "speed",
    "idleSampleInterval",
    "dialogueSampleRate",
    "speakBattleText",
    "allowBuiltInCamera",
    "keys"
  ],
  "properties" : {
    "$schema" : {
      "type" : [
        "string",
        "null"
      ]
    },
    "schemaVersion" : {
      "type" : "integer"
    },
    "engine" : {
      "type" : "string",
      "enum" : [
        "apple",
        "qwen3",
        "kokoro"
      ]
    },
    "speed" : {
      "type" : "number",
      "minimum" : 0.5,
      "maximum" : 2.0,
      "description" : "Global speaking-rate multiplier."
    },
    "idleSampleInterval" : {
      "type" : "number",
      "minimum" : 0.25,
      "maximum" : 3.0,
      "description" : "Seconds between checks while no dialogue box is visible."
    },
    "dialogueSampleRate" : {
      "type" : "number",
      "minimum" : 1.0,
      "maximum" : 10.0,
      "description" : "Samples per second while a dialogue box is visible."
    },
    "speakBattleText" : {
      "type" : "boolean"
    },
    "allowBuiltInCamera" : {
      "type" : "boolean",
      "description" : "The built-in camera faces the player, so it is only allowed when chosen explicitly."
    },
    "keys" : {
      "type" : "object",
      "required" : [
        "repeatLast",
        "repeatLastSlowly",
        "toggleSpeed",
        "togglePause",
        "recalibrate",
        "holdForEnglish"
      ],
      "properties" : {
        "repeatLast" : {
          "type" : "string",
          "pattern" : "^(shift\\+)?([a-z0-9]|space)$"
        },
        "repeatLastSlowly" : {
          "type" : "string",
          "pattern" : "^(shift\\+)?([a-z0-9]|space)$"
        },
        "toggleSpeed" : {
          "type" : "string",
          "pattern" : "^(shift\\+)?([a-z0-9]|space)$"
        },
        "togglePause" : {
          "type" : "string",
          "pattern" : "^(shift\\+)?([a-z0-9]|space)$"
        },
        "recalibrate" : {
          "type" : "string",
          "pattern" : "^(shift\\+)?([a-z0-9]|space)$"
        },
        "holdForEnglish" : {
          "type" : "string",
          "pattern" : "^(shift\\+)?([a-z0-9]|space)$",
          "description" : "Held down, shows the labels in English."
        },
        "toggleCamera" : {
          "type" : [
            "string",
            "null"
          ],
          "pattern" : "^(shift\\+)?([a-z0-9]|space)$",
          "description" : "Switches between the iPhone and the Mac's camera; `m` when absent. New keys are optional so\nexisting settings files keep loading without a migration."
        },
        "toggleRecap" : {
          "type" : [
            "string",
            "null"
          ],
          "pattern" : "^(shift\\+)?([a-z0-9]|space)$",
          "description" : "Opens or closes the recap (conversation and session words); `h` when absent."
        },
        "translateScreen" : {
          "type" : [
            "string",
            "null"
          ],
          "pattern" : "^(shift\\+)?([a-z0-9]|space)$",
          "description" : "Opens the whole-screen translation (Escape or the same key closes it); `t` when absent."
        }
      },
      "additionalProperties" : false
    }
  },
  "additionalProperties" : false
}
